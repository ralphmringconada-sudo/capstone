rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function adminDoc() {
      return get(adminPath());
    }

    function isAdmin() {
      return isSignedIn()
        && exists(adminPath())
        && (
          adminDoc().data.status == 'active'
          || adminDoc().data.status == 'Active'
        );
    }

    function isSuperAdmin() {
      return isAdmin() && adminDoc().data.role == 'super_admin';
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      // Signup must work as soon as Auth issues a UID — own-doc writes only.
      allow create: if isSignedIn() && request.auth.uid == userId;

      // setDoc retries count as updates; citizens and admins may update own/any profile.
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      allow delete: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /admins/{adminId} {
      // Own profile can always be read (fixes login permission loop)
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());

      // Super admin can create other admins.
      // Bootstrap: allow creating the first superadmin@gmail.com profile for yourself.
      allow create: if isSuperAdmin() || (
        isSignedIn()
        && request.auth.uid == adminId
        && request.auth.token.email == 'superadmin@gmail.com'
        && request.resource.data.email == 'superadmin@gmail.com'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'super_admin'
        && request.resource.data.status == 'active'
      );

      allow update: if isSuperAdmin()
        || (isAdmin() && request.auth.uid == adminId)
        || (
          isSignedIn()
          && request.auth.uid == adminId
          && request.auth.token.email == 'superadmin@gmail.com'
        );
      allow delete: if isSuperAdmin();
    }

    // Public username → email lookup for admin login (get only; no listing).
    match /admin_usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isSuperAdmin()
        || (isAdmin() && request.resource.data.uid == request.auth.uid);
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.reportedByUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.reportedByUid == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.reportedByUid == request.auth.uid
        && request.resource.data.reportedByUid == resource.data.reportedByUid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.reportedByUid == request.auth.uid);
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.status == 'Pending'
      );
      // Admin full control; owner may edit/delete Pending; any user may join/leave (participants counter).
      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.submittedByUid == request.auth.uid
          && resource.data.status == 'Pending'
          && request.resource.data.submittedByUid == resource.data.submittedByUid
          && request.resource.data.status == 'Pending'
        )
        || (
          isSignedIn()
          && resource.data.status in ['Upcoming', 'Ongoing']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'updatedAt'])
          && (
            request.resource.data.participants == resource.data.participants + 1
            || request.resource.data.participants == resource.data.participants - 1
          )
        );
      allow delete: if isAdmin()
        || (
          isSignedIn()
          && resource.data.submittedByUid == request.auth.uid
          && resource.data.status == 'Pending'
        );

      match /participants/{participantId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.auth.uid == participantId
          && request.resource.data.uid == request.auth.uid
          && get(/databases/$(database)/documents/events/$(eventId)).data.status in ['Upcoming', 'Ongoing'];
        allow delete: if isSignedIn() && request.auth.uid == participantId;
      }
    }

    match /admin_activity_logs/{logId} {
      allow read: if isSuperAdmin() || (isAdmin() && resource.data.adminUid == request.auth.uid);
      allow create: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin();
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /admin_notifications/{notificationId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin();
    }
  }
}
